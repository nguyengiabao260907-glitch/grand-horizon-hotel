@model List<LapTrinhWeb_pro.Models.BOOKING>
@using System.Linq
@{
    Layout = null;
    ViewBag.Title = "Đơn hàng của tôi";
    // Bản v5: admin chỉ quản lý phòng, không đặt phòng.
    bool isAdmin = (Session["GuestEmail"] as string ?? "").Trim().ToLower() == "admin@grandhorizon.vn";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đơn hàng của tôi — Grand Horizon Hotel</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/css.css")" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
    <nav>
        <div class="wrap">
            <a class="logo" href="@Url.Action("Index", "Home")">GRAND <span>HORIZON</span></a>
            <ul>
                <li><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                <li><a href="@Url.Action("Index", "Home")#diem-den">Điểm đến</a></li>
                <li><a href="@Url.Action("Index", "Home")#phong">Phòng</a></li>
                <li><a href="@Url.Action("Index", "Home")#dich-vu">Dịch vụ</a></li>
                <li><a href="@Url.Action("Index", "Buffet")">Thực đơn Buffet</a></li>
                <li><a href="@Url.Action("Contact", "Home")">Liên hệ</a></li>
                @if (!isAdmin)
                {
                    <li><a href="@Url.Action("Index", "Home")#dat-phong">Đặt phòng</a></li>
                }
                @if (Session["GuestName"] != null)
                {
                    if (!isAdmin)
                    {
                        <li><a href="@Url.Action("MyBookings", "Booking")">Đơn hàng của tôi</a></li>
                    }
                    if ((Session["GuestEmail"] as string ?? "").Trim().ToLower() == "admin@grandhorizon.vn")
                    {
                        <li><a href="@Url.Action("Index", "Admin")">Quản trị</a></li>
                    }
                    <li class="nav-hello">Xin chào, @Session["GuestName"]</li>
                    <li><a href="@Url.Action("Logout", "Account")">Đăng xuất</a></li>
                }
                else
                {
                    <li><a href="@Url.Action("Login", "Account")">Đăng nhập</a></li>
                    <li><a href="@Url.Action("Register", "Account")">Đăng ký</a></li>
                }
            </ul>
            @if (!isAdmin)
            {
                <a class="btn" href="@Url.Action("Index", "Home")#dat-phong">Đặt ngay</a>
            }
        </div>
    </nav>

    <section class="auth-page">
        <div class="wrap">
            <div class="center">
                <p class="kicker">Tài khoản của tôi</p>
                <h2>Đơn hàng của tôi</h2>
                <p class="sub">Xin chào @Session["GuestName"], đây là tất cả các đơn đặt phòng của bạn.</p>
                @if (TempData["CancelError"] != null)
                {
                    <p class="error">@TempData["CancelError"]</p>
                }
            </div>

            @if (Model == null || Model.Count == 0)
            {
                <div class="empty-box" style="max-width:640px;margin:40px auto 0">
                    <p>Bạn chưa có đặt phòng nào.</p>
                    <a class="btn" href="@Url.Action("Index", "Home")#dat-phong">Đặt phòng ngay</a>
                </div>
            }
            else
            {
                <table class="table-bookings" style="margin-top:40px">
                    <tr>
                        <th>Mã</th>
                        <th>Phòng</th>
                        <th>Khách sạn</th>
                        <th>Trạng thái</th>
                        <th>Nhận phòng</th>
                        <th>Trả phòng</th>
                        <th>Số đêm</th>
                        <th>Dịch vụ</th>
                        <th>Tổng tiền</th>
                        <th>Hủy</th>
                    </tr>
                    @foreach (var b in Model)
                    {
                        var detail = b.BOOKING_DETAIL.FirstOrDefault();
                        string roomName = detail != null && detail.ROOM != null && detail.ROOM.ROOM_TYPE != null ? detail.ROOM.ROOM_TYPE.name : "—";
                        string roomNo = detail != null && detail.ROOM != null ? detail.ROOM.room_number : "";
                        int nights = (b.check_out_date.Date - b.check_in_date.Date).Days;
                        string services = b.SERVICE_BOOKING != null && b.SERVICE_BOOKING.Count > 0
                            ? string.Join(", ", b.SERVICE_BOOKING.Where(s => s.SERVICE != null).Select(s => s.SERVICE.service_name))
                            : "—";
                        string hotel = b.PROPERTY != null
                            ? b.PROPERTY.property_name + " — " + b.PROPERTY.address
                            : "—";
                        // Trạng thái tính từ ngày, không thêm cột database.
                        string status = b.check_in_date.Date > System.DateTime.Today ? "Sắp tới"
                            : (b.check_out_date.Date > System.DateTime.Today ? "Đang ở" : "Đã trả phòng");
                        <tr>
                            <td>#@b.book_id</td>
                            <td>@roomName@(string.IsNullOrEmpty(roomNo) ? "" : " (Phòng " + roomNo + ")")</td>
                            <td>@hotel</td>
                            <td>@status</td>
                            <td>@b.check_in_date.ToString("dd/MM/yyyy")</td>
                            <td>@b.check_out_date.ToString("dd/MM/yyyy")</td>
                            <td>@nights đêm</td>
                            <td>@services</td>
                            <td class="money">@b.total_amount.ToString("N0") đ</td>
                            <td>
                                @if (b.check_out_date.Date > System.DateTime.Today)
                                {
                                    <form method="post" action="@Url.Action("Cancel", "Booking")" onsubmit="return confirm('Bạn chắc chắn muốn hủy đặt phòng này?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@b.book_id">
                                        <button type="submit" class="btn dark">Hủy</button>
                                    </form>
                                }
                                else
                                {
                                    <span>Đã trả phòng</span>
                                }
                            </td>
                        </tr>
                    }
                </table>
                if (!isAdmin)
                {
                    <p class="auth-switch"><a href="@Url.Action("Index", "Home")#dat-phong">Đặt thêm phòng mới →</a></p>
                }
            }
        </div>
    </section>

    <footer>
        <div class="wrap">
            <div class="grid">
                <div><h3>Grand Horizon</h3><p>Khách sạn &amp; Khu nghỉ dưỡng 4★</p></div>
                <div><h3><a href="@Url.Action("Contact", "Home")">Liên hệ</a></h3><p>123 Đường Biển, Đà Nẵng</p><p>0369 436 165</p></div>
                <div><h3>Khám phá</h3><a href="@Url.Action("Index", "Home")#diem-den">Điểm đến</a><a href="@Url.Action("Index", "Home")#phong">Phòng</a><a href="@Url.Action("Index", "Home")#dich-vu">Dịch vụ</a></div>
                <div><h3>Giờ làm việc</h3><p>Lễ tân: 24/7</p><p>Nhà hàng: 6:00 – 22:00</p></div>
            </div>
            <p style="text-align:center;margin-top:30px">© 2026 - Grand Horizon Hotel</p>
        </div>
    </footer>
</body>
</html>
