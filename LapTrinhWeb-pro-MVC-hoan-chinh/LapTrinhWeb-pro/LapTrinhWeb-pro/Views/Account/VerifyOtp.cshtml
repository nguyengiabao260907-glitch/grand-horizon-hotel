@{
    Layout = null;
    ViewBag.Title = "Xác minh mã OTP";
    // Bản v5: admin chỉ quản lý phòng, không đặt phòng.
    bool isAdmin = (Session["GuestEmail"] as string ?? "").Trim().ToLower() == "admin@grandhorizon.vn";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Xác minh mã OTP — Grand Horizon Hotel</title>
    <link rel="stylesheet" href="@Url.Content("~/Content/css.css")" />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
</head>
<body>
    <nav>
        <div class="wrap">
            <a class="logo" href="@Url.Action("Index", "Home")">GRAND <span>HORIZON</span></a>
            <ul>
                <li><a href="@Url.Action("Index", "Home")">Trang chủ</a></li>
                @if ((Session["GuestEmail"] as string ?? "").Trim().ToLower() == "admin@grandhorizon.vn")
                {
                    <li><a href="@Url.Action("Index", "Admin")">Quản trị</a></li>
                }
                <li><a href="@Url.Action("Index", "Home")#diem-den">Điểm đến</a></li>
                <li><a href="@Url.Action("Index", "Home")#phong">Phòng</a></li>
                <li><a href="@Url.Action("Index", "Home")#dich-vu">Dịch vụ</a></li>
                <li><a href="@Url.Action("Index", "Buffet")">Thực đơn Buffet</a></li>
                <li><a href="@Url.Action("Contact", "Home")">Liên hệ</a></li>
                @if (!isAdmin)
                {
                    <li><a href="@Url.Action("Index", "Home")#dat-phong">Đặt phòng</a></li>
                }
                <li><a href="@Url.Action("Login", "Account")">Đăng nhập</a></li>
                <li><a href="@Url.Action("Register", "Account")">Đăng ký</a></li>
            </ul>
            @if (!isAdmin)
            {
                <a class="btn" href="@Url.Action("Index", "Home")#dat-phong">Đặt ngay</a>
            }
        </div>
    </nav>

    <section class="auth-page">
        <div class="wrap">
            <div class="auth-box form-box">
                <div class="center">
                    <p class="kicker">Grand Horizon Hotel</p>
                    <h2>Xác minh mã OTP</h2>
                    <p class="sub">Chúng tôi đã gửi mã xác minh 6 số tới email <b>@(ViewBag.Email ?? "")</b>. Mã hết hạn sau 5 phút.</p>
                </div>
                @if (ViewBag.Error != null)
                {
                    <p class="error">@ViewBag.Error</p>
                }
                @if (ViewBag.Info != null)
                {
                    <p class="info">@ViewBag.Info</p>
                }
                @if (ViewBag.MailError != null)
                {
                    <p class="error">@ViewBag.MailError</p>
                }
                @if (ViewBag.DemoOtp != null)
                {
                    <p class="demo-otp">Chế độ demo — mã OTP của bạn là: <b>@ViewBag.DemoOtp</b></p>
                }
                <form method="post" action="@Url.Action("VerifyOtp", "Account")">
                    @Html.AntiForgeryToken()
                    <div class="field">
                        <label>Mã OTP (6 số) *</label>
                        <input class="otp-input" type="text" name="otp" placeholder="123456" maxlength="6" inputmode="numeric" autocomplete="one-time-code" required>
                    </div>
                    <button class="btn" type="submit" style="width:100%">Xác nhận</button>
                </form>
                <form method="post" action="@Url.Action("ResendOtp", "Account")" style="margin-top:12px">
                    @Html.AntiForgeryToken()
                    <button class="btn dark" type="submit" style="width:100%">Gửi lại mã</button>
                </form>
                <p class="auth-switch"><a href="@Url.Action("Login", "Account")">← Quay lại đăng nhập</a></p>
            </div>
        </div>
    </section>

    <footer>
        <div class="wrap">
            <div class="grid">
                <div><h3>Grand Horizon</h3><p>Khách sạn &amp; Khu nghỉ dưỡng 4★</p></div>
                <div><h3><a href="@Url.Action("Contact", "Home")">Liên hệ</a></h3><p>123 Đường Biển, Đà Nẵng</p><p>0369 436 165</p></div>
                <div><h3>Khám phá</h3><a href="@Url.Action("Index", "Home")#diem-den">Điểm đến</a><a href="@Url.Action("Index", "Home")#phong">Phòng</a><a href="@Url.Action("Index", "Home")#dich-vu">Dịch vụ</a></div>
                <div><h3>Giờ làm việc</h3><p>Lễ tân: 24/7</p><p>Nhà hàng: 6:00 – 22:00</p></div>
            </div>
            <p style="text-align:center;margin-top:30px">© 2026 - Grand Horizon Hotel</p>
        </div>
    </footer>
</body>
</html>
